<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Nexdev" value="https://nuget.nexdev.net/api/v2/" />
  </packageSources>
  <packageSourceMapping>
    <!-- Map Fanex packages to Nexdev source -->
    <packageSource key="Nexdev">
      <package pattern="Fanex.*" />
    </packageSource>
    <!-- Map all other packages to nuget.org -->
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
      <package pattern="System.*" />
      <package pattern="Hangfire.*" />
      <package pattern="Polly.*" />
      <package pattern="AspNetCore*" />
      <package pattern="StackExchange.*" />
      <package pattern="Swashbuckle.*" />
      <package pattern="dotnet-sonarscanner" />
    </packageSource>
  </packageSourceMapping>
</configuration>

