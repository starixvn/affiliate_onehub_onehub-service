{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/src/ONEHub.Api/bin/Debug/net9.0/ONEHub.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/ONEHub.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Launch API (No Build)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "",
      "program": "${workspaceFolder}/src/ONEHub.Api/bin/Debug/net9.0/ONEHub.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/ONEHub.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Launch CronJob",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-cronjob",
      "program": "${workspaceFolder}/src/ONEHub.CronJob/bin/Debug/net9.0/ONEHub.CronJob.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/ONEHub.CronJob",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Launch CronJob (No Build)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "",
      "program": "${workspaceFolder}/src/ONEHub.CronJob/bin/Debug/net9.0/ONEHub.CronJob.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/ONEHub.CronJob",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Attach to API",
      "type": "coreclr",
      "request": "attach",
      "processName": "ONEHub.Api"
    },
    {
      "name": "Attach to CronJob",
      "type": "coreclr",
      "request": "attach",
      "processName": "ONEHub.CronJob"
    }
  ],
  "compounds": [
    {
      "name": "Launch All (API + CronJob)",
      "configurations": ["Launch API", "Launch CronJob"],
      "stopAll": true
    }
  ]
}
